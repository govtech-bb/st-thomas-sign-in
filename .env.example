# Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Settings -> API -> service_role) -- server-side only, NEVER expose
SUPABASE_SERVICE_ROLE_KEY=

# Staff PIN for /staff route. Treated as a shared secret. Must be at least
# 6 characters and not an all-numeric short PIN -- the server refuses to
# authenticate (and shows a "misconfigured" error) for weaker values.
STAFF_PIN=

# Public base URL of the deployed app, used by the QR code (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
