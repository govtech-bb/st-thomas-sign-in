# Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Settings -> API -> service_role) -- server-side only, NEVER expose
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app, used by the QR code (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Note: staff sign-in now uses Supabase Auth (email + password).
# Seed demo accounts by running supabase/migrations/0002_seed_staff.sql.
